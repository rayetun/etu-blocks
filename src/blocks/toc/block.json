{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "etu/toc",
	"version": "1.0.0",
	"title": "Table of Contents",
	"category": "etu-blocks",
	"icon": "list-view",
	"description": "An accessible table of contents built automatically from the page's headings — with smooth scroll, active-section highlighting and an optional collapse.",
	"keywords": [ "table of contents", "toc", "index", "navigation", "anchors" ],
	"textdomain": "etu-blocks",
	"supports": {
		"html": false,
		"anchor": true,
		"interactivity": true,
		"align": [ "wide" ]
	},
	"attributes": {
		"title": { "type": "string", "default": "Table of contents" },
		"showTitle": { "type": "boolean", "default": true },
		"listType": { "type": "string", "default": "number" },
		"minLevel": { "type": "string", "default": "2" },
		"maxLevel": { "type": "string", "default": "4" },
		"preset": { "type": "string", "default": "boxed" },
		"collapsible": { "type": "boolean", "default": false },
		"initialCollapsed": { "type": "boolean", "default": false },
		"sticky": { "type": "boolean", "default": false },
		"smoothScroll": { "type": "boolean", "default": true },
		"scrollspy": { "type": "boolean", "default": true },
		"accentColor": { "type": "string", "default": "" },
		"background": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" },
		"blockId": { "type": "string", "default": "" },
		"blockPadding": { "type": "object", "default": {} },
		"blockMargin": { "type": "object", "default": {} }
	},
	"example": { "attributes": { "title": "Table of contents" } },
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
